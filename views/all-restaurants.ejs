<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <%- include('./navbar')%>

<h1>All restaurants</h1>

<% for(restaurant of restaurants){ %>
    
<a href="/restaurants/<%= restaurant.id %>">
    <ol>
  <%= restaurant.name %> -
  
  <% if (restaurant.isOpen === false) { %>
    Closed
  <% } %>
</ol>

<% }%>
</body>
</html>

