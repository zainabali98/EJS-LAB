<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <%- include('./navbar')%>
    <h1>Resturaunt details</h1>
    <%= restaurant.name%>
    <%= restaurant.address%>
    <%= restaurant.isOpen%>
    <%= restaurant.phone%>


    <% for (menu of restaurant.menu){ %>
        <p><%= menu.name %></p>
        <p><%= 'Price:' + " " +  menu.price %></p>
    <p><%=  'Rating:' + " " + menu.rating %></p>
    <% }%>
</body>
</html>
